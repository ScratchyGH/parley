{
  "name": "parley",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').writeFileSync('wrangler.local.toml',require('fs').readFileSync('wrangler.toml','utf8').split('\\n[ai]')[0])\" && wrangler dev -c wrangler.local.toml --port 8787",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node test/run.mjs",
    "test:static": "node test/safety.mjs && node test/static.mjs && node test/md.mjs && node test/slash.mjs && node test/push.mjs && node test/codec.mjs && node test/p2p.mjs",
    "deploy": "wrangler deploy",
    "test:store": "node test/store.mjs",
    "test:signin": "node test/signin.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "wrangler": "^4.0.0",
    "ws": "^8.18.0"
  }
}
